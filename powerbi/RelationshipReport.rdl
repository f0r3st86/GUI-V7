<DataSets><DataSet Name="dsProjects"><Query><DataSourceName>MidwestDDi</DataSourceName><CommandText>SELECT ProjectName FROM tblProjects ORDER BY ProjectName</CommandText></Query><Fields><Field Name="ProjectName"><DataField>ProjectName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsRelList"><Query><DataSourceName>MidwestDDi</DataSourceName><QueryParameters><QueryParameter Name="@ProjectName"><Value>=Parameters!ProjectName.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT RelatedLoans, SortNo FROM tblRelationships WHERE ProjectName = @ProjectName ORDER BY SortNo, RelatedLoans</CommandText></Query><Fields><Field Name="RelatedLoans"><DataField>RelatedLoans</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="SortNo"><DataField>SortNo</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsRelationship"><Query><DataSourceName>MidwestDDi</DataSourceName><QueryParameters><QueryParameter Name="@ProjectName"><Value>=Parameters!ProjectName.Value</Value></QueryParameter><QueryParameter Name="@RelatedLoans"><Value>=Parameters!RelatedLoans.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT RelatedLoans, ProjectName, SortNo, ExitCode, RelationshipOverview, CollateralOverview, ExitStrategyOverview, ConditionsDeadlines, InBankruptcy, ForeclosureFlag, LitigationFlag, ForbearanceFlag, JudgmentFlag, LowYieldAsset FROM tblRelationships WHERE ProjectName = @ProjectName AND RelatedLoans = @RelatedLoans</CommandText></Query><Fields><Field Name="RelatedLoans"><DataField>RelatedLoans</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ProjectName"><DataField>ProjectName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="SortNo"><DataField>SortNo</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="ExitCode"><DataField>ExitCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="RelationshipOverview"><DataField>RelationshipOverview</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="CollateralOverview"><DataField>CollateralOverview</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ExitStrategyOverview"><DataField>ExitStrategyOverview</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ConditionsDeadlines"><DataField>ConditionsDeadlines</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="InBankruptcy"><DataField>InBankruptcy</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="ForeclosureFlag"><DataField>ForeclosureFlag</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="LitigationFlag"><DataField>LitigationFlag</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="ForbearanceFlag"><DataField>ForbearanceFlag</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="JudgmentFlag"><DataField>JudgmentFlag</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="LowYieldAsset"><DataField>LowYieldAsset</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsLoans"><Query><DataSourceName>MidwestDDi</DataSourceName><QueryParameters><QueryParameter Name="@ProjectName"><Value>=Parameters!ProjectName.Value</Value></QueryParameter><QueryParameter Name="@RelatedLoans"><Value>=Parameters!RelatedLoans.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT MWLoanNo, BorrowerNm, Pool, OrigPrincipalBalance, PrincipalBalance, InterestBalance, Rate, DefaultRate, RepayAmt, DueDt, LastPmtDt, CurrentMaturityDate FROM tblLoan WHERE ProjectName = @ProjectName AND RelatedLoans = @RelatedLoans ORDER BY PrincipalBalance DESC</CommandText></Query><Fields><Field Name="MWLoanNo"><DataField>MWLoanNo</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BorrowerNm"><DataField>BorrowerNm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Pool"><DataField>Pool</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="OrigPrincipalBalance"><DataField>OrigPrincipalBalance</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="PrincipalBalance"><DataField>PrincipalBalance</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="InterestBalance"><DataField>InterestBalance</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="Rate"><DataField>Rate</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="DefaultRate"><DataField>DefaultRate</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="RepayAmt"><DataField>RepayAmt</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="DueDt"><DataField>DueDt</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="LastPmtDt"><DataField>LastPmtDt</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="CurrentMaturityDate"><DataField>CurrentMaturityDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsCollateral"><Query><DataSourceName>MidwestDDi</DataSourceName><QueryParameters><QueryParameter Name="@ProjectName"><Value>=Parameters!ProjectName.Value</Value></QueryParameter><QueryParameter Name="@RelatedLoans"><Value>=Parameters!RelatedLoans.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT Priority, MWPropertyNo, MWCollateralCode, Description, Address, City, State, CurrentAppraisedValue, SeniorLienAmount, TaxDelinquentAmt, CASE WHEN ISNULL(CurrentAppraisedValue,0) - ISNULL(SeniorLienAmount,0) - ISNULL(TaxDelinquentAmt,0) > 0 THEN ISNULL(CurrentAppraisedValue,0) - ISNULL(SeniorLienAmount,0) - ISNULL(TaxDelinquentAmt,0) ELSE 0 END AS NetValue FROM CollateralInfo WHERE ProjectName = @ProjectName AND RelatedLoans = @RelatedLoans ORDER BY Priority</CommandText></Query><Fields><Field Name="Priority"><DataField>Priority</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="MWPropertyNo"><DataField>MWPropertyNo</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="MWCollateralCode"><DataField>MWCollateralCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Description"><DataField>Description</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Address"><DataField>Address</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="City"><DataField>City</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="State"><DataField>State</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="CurrentAppraisedValue"><DataField>CurrentAppraisedValue</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="SeniorLienAmount"><DataField>SeniorLienAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="TaxDelinquentAmt"><DataField>TaxDelinquentAmt</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="NetValue"><DataField>NetValue</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsBorrowers"><Query><DataSourceName>MidwestDDi</DataSourceName><QueryParameters><QueryParameter Name="@ProjectName"><Value>=Parameters!ProjectName.Value</Value></QueryParameter><QueryParameter Name="@RelatedLoans"><Value>=Parameters!RelatedLoans.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT BorrName, City, State, BeaconScore, BKStatus, IsBusiness FROM tblBorrowers WHERE ProjectName = @ProjectName AND RelatedLoans = @RelatedLoans ORDER BY BorrName</CommandText></Query><Fields><Field Name="BorrName"><DataField>BorrName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="City"><DataField>City</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="State"><DataField>State</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BeaconScore"><DataField>BeaconScore</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="BKStatus"><DataField>BKStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="IsBusiness"><DataField>IsBusiness</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsPayHist"><Query><DataSourceName>MidwestDDi</DataSourceName><QueryParameters><QueryParameter Name="@ProjectName"><Value>=Parameters!ProjectName.Value</Value></QueryParameter><QueryParameter Name="@RelatedLoans"><Value>=Parameters!RelatedLoans.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT [Year], SUM(ISNULL(PHJan,0)) AS M1, SUM(ISNULL(PHFeb,0)) AS M2, SUM(ISNULL(PHMar,0)) AS M3, SUM(ISNULL(PHApr,0)) AS M4, SUM(ISNULL(PHMay,0)) AS M5, SUM(ISNULL(PHJun,0)) AS M6, SUM(ISNULL(PHJul,0)) AS M7, SUM(ISNULL(PHAug,0)) AS M8, SUM(ISNULL(PHSep,0)) AS M9, SUM(ISNULL(PHOct,0)) AS M10, SUM(ISNULL(PHNov,0)) AS M11, SUM(ISNULL(PHDec,0)) AS M12, SUM(ISNULL(SumOfAmount,0)) AS Total FROM vwPayHistorySpread WHERE ProjectName = @ProjectName AND RelatedLoans = @RelatedLoans GROUP BY [Year] ORDER BY [Year]</CommandText></Query><Fields><Field Name="Year"><DataField>Year</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="M1"><DataField>M1</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="M2"><DataField>M2</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="M3"><DataField>M3</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="M4"><DataField>M4</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="M5"><DataField>M5</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="M6"><DataField>M6</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="M7"><DataField>M7</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="M8"><DataField>M8</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="M9"><DataField>M9</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="M10"><DataField>M10</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="M11"><DataField>M11</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="M12"><DataField>M12</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="Total"><DataField>Total</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field></Fields></DataSet><DataSet Name="dsComments"><Query><DataSourceName>MidwestDDi</DataSourceName><QueryParameters><QueryParameter Name="@ProjectName"><Value>=Parameters!ProjectName.Value</Value></QueryParameter><QueryParameter Name="@RelatedLoans"><Value>=Parameters!RelatedLoans.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT c.MWLoanNo, c.RelatedLoans, c.AcctOfficer, c.[Date] AS CmtDate, c.[Group] AS CmtGroup, c.Comment, CASE WHEN c.MWLoanNo = c.RelatedLoans THEN 1 ELSE 0 END AS RelLevel FROM tblcomments c LEFT JOIN ztblCommentGroups zg ON c.[Group] = zg.GroupName WHERE c.ProjectName = @ProjectName AND c.RelatedLoans = @RelatedLoans ORDER BY CASE WHEN c.MWLoanNo = c.RelatedLoans THEN 0 ELSE 1 END, ISNULL(zg.ReportPriority, 999), c.[Date] DESC</CommandText></Query><Fields><Field Name="MWLoanNo"><DataField>MWLoanNo</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="RelatedLoans"><DataField>RelatedLoans</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="AcctOfficer"><DataField>AcctOfficer</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="CmtDate"><DataField>CmtDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="CmtGroup"><DataField>CmtGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Comment"><DataField>Comment</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="RelLevel"><DataField>RelLevel</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet></DataSets>
