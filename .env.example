# API Configuration
# For development with mock data, leave this as 'mock'
# When you have a real backend, set this to your API URL
VITE_API_URL=mock

# Examples for different environments:
# Development: http://localhost:3000/api
# Staging: https://staging-api.yourapp.com/api
# Production: https://api.yourapp.com/api

# ==================== MICROSOFT AUTHENTICATION ====================
# Get these values from Azure Portal > App registrations > Your app
# Documentation: https://learn.microsoft.com/en-us/azure/active-directory/develop/quickstart-register-app

# Application (client) ID from Azure AD app registration
VITE_AZURE_CLIENT_ID=your-client-id-here

# Directory (tenant) ID from Azure AD
# Use your specific tenant ID for single-tenant app (recommended)
# Use 'common' for multi-tenant (not recommended for internal apps)
VITE_AZURE_TENANT_ID=your-tenant-id-here

# Redirect URI - must match what's configured in Azure AD
# Development
VITE_AZURE_REDIRECT_URI=http://localhost:3000/auth/callback
# Production (update this when deploying)
# VITE_AZURE_REDIRECT_URI=https://yourapp.com/auth/callback

# ==================== SECURITY NOTES ====================
# 1. NEVER commit the actual .env file to git (only .env.example)
# 2. Client ID and Tenant ID are safe to expose in frontend
# 3. Client Secret should ONLY be stored on backend (never in frontend!)
# 4. Use different app registrations for dev/staging/production
